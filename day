<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Happy Girl's Day 💗</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;

      font-family: Arial, sans-serif;

      background:
        radial-gradient(circle at top left, #ffffff 5%, transparent 30%),
        linear-gradient(135deg, #ffd6e7, #ffeef5, #ffd1e3);

      overflow: hidden;
    }

    .card {
      width: 90%;
      max-width: 500px;
      padding: 45px 30px;
      text-align: center;

      background: rgba(255, 255, 255, 0.88);
      border-radius: 30px;

      box-shadow: 0 20px 50px rgba(180, 80, 120, 0.2);

      animation: muncul 1s ease;
    }

    .flowers {
      font-size: 45px;
      margin-bottom: 15px;

      animation: goyang 2s infinite;
    }

    h1 {
      color: #e75480;
      font-size: 38px;
      margin-bottom: 15px;
    }

    .subtitle {
      color: #777;
      font-size: 17px;
      margin-bottom: 25px;
    }

    button {
      border: none;
      padding: 14px 28px;

      background: #e75480;
      color: white;

      font-size: 16px;
      font-weight: bold;

      border-radius: 30px;
      cursor: pointer;

      transition: 0.3s;
    }

    button:hover {
      transform: scale(1.08);
      background: #d94370;
    }

    #pesan {
      display: none;

      margin-top: 30px;
      padding: 25px;

      background: #fff0f6;
      border-radius: 20px;

      animation: muncul 0.8s ease;
    }

    #pesan h2 {
      color: #e75480;
      margin-bottom: 12px;
    }

    #pesan p {
      color: #666;
      line-height: 1.7;
    }

    .heart {
      font-size: 45px;
      margin-top: 15px;

      animation: detak 1s infinite;
    }

    .footer {
      margin-top: 25px;
      color: #aaa;
      font-size: 13px;
    }

    @keyframes muncul {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes goyang {
      0%, 100% {
        transform: rotate(-5deg);
      }

      50% {
        transform: rotate(5deg);
      }
    }

    @keyframes detak {
      0%, 100% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.25);
      }
    }
  </style>
</head>

<body>

  <div class="card">

    <div class="flowers">
      🌸 🌷 🌸
    </div>

    <h1>Happy Girl's Day 💗</h1>

    <p class="subtitle">
      Untuk kamu yang luar biasa...
    </p>

    <button onclick="bukaPesan()">
      💌 Buka Pesan
    </button>

    <div id="pesan">

      <h2>✨ Untuk Kamu ✨</h2>

      <p>
        Jangan pernah meragukan dirimu sendiri.
        Kamu punya cahaya yang hanya kamu miliki.
        Tetap tersenyum, tetap kuat, dan terus mengejar
        impianmu. 🌷
      </p>

      <div class="heart">
        ❤️
      </div>

    </div>

    <p class="footer">
      Made with 💗
    </p>

  </div>

  <script>
    function bukaPesan() {

      const pesan = document.getElementById("pesan");

      pesan.style.display = "block";

      for (let i = 0; i < 15; i++) {
        buatHati();
      }
    }

    function buatHati() {

      const hati = document.createElement("div");

      hati.innerHTML = "💗";

      hati.style.position = "fixed";
      hati.style.left = Math.random() * 100 + "vw";
      hati.style.bottom = "-30px";
      hati.style.fontSize = "20px";
      hati.style.zIndex = "999";

      document.body.appendChild(hati);

      hati.animate(
        [
          {
            transform: "translateY(0)",
            opacity: 1
          },

          {
            transform: "translateY(-100vh)",
            opacity: 0
          }
        ],
        {
          duration: 3000 + Math.random() * 2000,
          easing: "ease-out"
        }
      );

      setTimeout(() => {
        hati.remove();
      }, 5000);
    }
  </script>

</body>
</html>
